# brain.ctx — AI Constitution Standard v1.0
# Generated by brain-ctx (https://manasdb.com)
#
# This file is auto-maintained. The codebase IS the source of truth.
# Only edit: identity.vision, hard_rules, ethics (if needed).
# Everything else is inferred automatically.
#
# Spec: https://github.com/manasdb/brain-ctx
# ─────────────────────────────────────────────────────────────────────
# brain.ctx spec version
version: '1.0'

# ── Project Identity (auto-inferred, you may refine vision) ──────────
identity:
  name: '@Manasdb/Core'
  author: ManasDB Contributors
  domain: github.com/manasdb/manasdb#readme
  vision: The memory layer for AI applications — hybrid RAG retrieval, PII shield,
    polyglot storage
  license: SEE LICENSE IN LICENSE

# ── Inference Config (what brain.ctx reads automatically) ─────────────
inference:
  enabled: true
  mode: propose_only
  require_validation: true
  sources:
  - codebase
  - git
  - tests
  - dependencies
  confidence_threshold: 0.8
  human_review_queue: .brain-ctx.proposals.yaml

# ── Trust & Agent Permissions ────────────────────────────────────────
trust:
  default: read_only
  mutex_files:
  - package.json
  - src/index.js
  - src/core/memory-engine.js
  - examples/mongodb-basic/index.js
  - examples/polyglot-mode/index.js
  - examples/postgres-basic/index.js
  never_touch:
  - '*.lock'
  - '*.env'
  - '*.backup'
  - '*.sock'
  - '*.env.local'
  - '*.socket'
  - '*.pid'
  agents:
    architect:
      can:
      - read_all
      - propose_changes
      cannot:
      - write
      - delete
    implementor:
      can:
      - write_code
      - run_tests
      cannot:
      - change_architecture
      - touch_mutex_files
    reviewer:
      can:
      - read_all
      - flag_violations
      cannot:
      - write

# ── Hard Rules (absolute constraints for AI — never violated) ─────────
# CRITICAL: This section provides the only real constraints to AI agents.
# Tip: Use project-wide "ALWAYS/NEVER" directives here.
hard_rules:
- NEVER bypass security checks or input validation logic.
- NEVER store credentials, PII, or secrets in plaintext.
- ALWAYS run the verification test suite before proposing changes.
- NEVER delete .backup or .socket files without human confirmation.

# ── Ethics & Data Protection ─────────────────────────────────────────
ethics:
  never_expose:
  - llm_api_keys
  - user_embeddings
  - user_query_text
  - private_keys
  - database_connection_strings
  never_delete:
  - '*.backup'

# ── Truth Sources (pointers to live facts — never goes stale) ─────────
truth_sources:
  api_surface:
    infer_from: src/index.js
    pattern: ^export (function|class|const|let|default|type|interface)
    auto_extract: true
    stack: Node.js / TypeScript
  conventions:
    infer_from: .git/commits
    last_n: 100
    auto_learn: true
  invariants:
    infer_from: tests/
    pattern: test_invariant_*
    auto_register: true
  dependencies:
    infer_from: Cargo.toml,package.json,requirements.txt,pyproject.toml
    auto_extract: true

# ── Cognitive Optimizer (adapts context to each AI model) ─────────────
# Tip: Adding a "timeline:" block triggers architecture/decisions focus.
cognitive:
  modes:
    debug:
      prioritize:
      - logs
      - invariants
      - hard_rules
    build:
      prioritize:
      - api_surface
      - dependencies
      - trust_tiers
    refactor:
      prioritize:
      - invariants
  critical:
  - api_surface
  - trust_tiers
  - hard_rules
  - verification
  - invariants
  important:
  - conventions
  reference:
  - full_history
  - benchmarks
  - detailed_api
  token_budget:
    claude: 12000
    gpt4: 8000
    gemini: 20000
    local: 2000

# ── Observability (audit log of AI actions) ──────────────────────────
observability:
  enabled: true
  log_file: .brain-ctx.log
  log_format: json
  retention: 90_days
  capture:
  - writes
  - proposals
  - rejections
  - violations
verification:
  auto_verify: false
  test_command: pytest
  build_command: npm run build
